{
  "version": 2,
  "builds": [
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    },
    {
      "src": "core/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "core/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/accounts/tasks/run-daily-payouts/",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/accounts/tasks/run-reconciliation/",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/accounts/tasks/run-clear-idempotency/",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/accounts/tasks/run-goal-reminders/",
      "schedule": "0 8 * * *"
    }
  ]
}
